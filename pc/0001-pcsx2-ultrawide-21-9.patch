+// Rescales the common 16:9 widescreen-hack float constants to their 21:9
+// equivalents. Only bit-for-bit recognizable aspect constants are touched;
+// anything else (zoom factors, FOV tweaks, code patches) passes through
+// unchanged. Also handles the MIPS LUI pattern where the upper half of the
+// float lives in the instruction immediate (lower half is truncated there,
+// which costs at most ~0.2% of ratio accuracy -- visually irrelevant).
+bool Patch::ConvertWSWordToUW(u32 value, u32* out)
+{
+	static constexpr const std::pair<float, float> s_ws_to_uw[] = {
+		{3.0f / 4.0f, 4.0f / 7.0f}, // x-compress: (4:3)/(16:9) -> (4:3)/(21:9)
+		{9.0f / 16.0f, 9.0f / 21.0f}, // inverse aspect: 9/16 -> 9/21
+		{16.0f / 9.0f, 21.0f / 9.0f}, // aspect: 16/9 -> 21/9
+		{4.0f / 3.0f, 7.0f / 4.0f}, // x-stretch: (16:9)/(4:3) -> (21:9)/(4:3)
+	};
+
+	float f;
+	std::memcpy(&f, &value, sizeof(f));
+	for (const auto& [ws, uw] : s_ws_to_uw)
+	{
+		const float diff = (f > ws) ? (f - ws) : (ws - f);
+		if (diff <= ws * 0.002f)
+		{
+			std::memcpy(out, &uw, sizeof(*out));
+			return true;
+		}
+	}
+
+	// MIPS LUI rt, imm16 with the float's upper half in the immediate.
+	if ((value >> 26) == 0x0F)
+	{
+		const u32 imm = value & 0xFFFFu;
+		for (const auto& [ws, uw] : s_ws_to_uw)
+		{
+			u32 wsb, uwb;
+			std::memcpy(&wsb, &ws, sizeof(wsb));
+			std::memcpy(&uwb, &uw, sizeof(uwb));
+			if (imm == (wsb >> 16))
+			{
+				*out = (value & 0xFFFF0000u) | (uwb >> 16);
+				return true;
+			}
+		}
+	}
+
+	return false;
+}
+
+// When a game only ships a "Widescreen 16:9" section, synthesize a
+// "Widescreen 21:9" group from it by rescaling the recognized aspect
+// constants (same patch addresses, adjusted values). Skipped when the game
+// already has a native 21:9 section. The synthesized group participates in
+// name-based activation like any other, i.e. it is picked up by the
+// "Apply Ultrawide (21:9) Patches" toggle or a manual per-game enable.
+void Patch::SynthesizeUltrawidePatches(std::vector<PatchGroup>* patch_list)
+{
+	if (std::any_of(patch_list->begin(), patch_list->end(),
+			[](const PatchGroup& g) { return g.name == UW_PATCH_NAME; }))
+	{
+		return;
+	}
+
+	const auto ws_it = std::find_if(patch_list->begin(), patch_list->end(),
+		[](const PatchGroup& g) { return g.name == WS_PATCH_NAME; });
+	if (ws_it == patch_list->end() || !ws_it->dpatches.empty())
+		return;
+
+	PatchGroup uw;
+	uw.name = UW_PATCH_NAME;
+	uw.override_aspect_ratio = 21.0f / 9.0f;
+	uw.override_interlace_mode = ws_it->override_interlace_mode;
+
+	u32 converted = 0;
+	for (const PatchCommand& cmd : ws_it->patches)
+	{
+		// BYTES_T owns a heap buffer and never carries aspect floats; bail
+		// instead of guessing.
+		if (cmd.type == BYTES_T)
+			return;
+
+		PatchCommand copy;
+		copy.placetopatch = cmd.placetopatch;
+		copy.cpu = cmd.cpu;
+		copy.type = cmd.type;
+		copy.addr = cmd.addr;
+		copy.data = cmd.data;
+
+		u32 out = 0;
+		if (cmd.cpu == CPU_EE &&
+			(cmd.type == WORD_T || (cmd.type == EXTENDED_T && (cmd.addr >> 28) == 2)) &&
+			ConvertWSWordToUW(static_cast<u32>(cmd.data), &out))
+		{
+			copy.data = out;
+			converted++;
+		}
+
+		uw.patches.push_back(std::move(copy));
+	}
+
+	if (converted == 0)
+		return;
+
+	Console.WriteLn(Color_Green,
+		fmt::format("Synthesized '{}' from '{}' ({}/{} values rescaled).",
+			UW_PATCH_NAME, WS_PATCH_NAME, converted, uw.patches.size()));
+	patch_list->push_back(std::move(uw));
+}
