gametitle=Enthusia - Professional Racing (SLUS-20967) 81D233DC

// Enable ONLY ONE of the three Widescreen sections at a time -- they all
// write the same x-scale floats at 0x383708/0x383728, just with different
// target ratios:
//   16:9        -> 0x3F400000 (0.75     = (4/3)/(16/9))
//   21:9 (2.33) -> 0x3F124925 (0.571428 = (4/3)/(21/9))   pair with the
//                  "Ultrawide (21:9)" aspect option of the custom build
//   64:27(2.37) -> 0x3F100000 (0.5625   = (4/3)/(64/27))  true ultrawide
//                  monitor (2560x1080 / 3440x1440), use Stretch fullscreen

[Widescreen 16:9]
gsaspectratio=16:9
author=No.47 & PeterDelta
description=Renders the game in 16:9 aspect ratio.
patch=1,EE,00383708,word,3F400000
patch=1,EE,00383728,word,3F400000


[Widescreen 21:9]
gsaspectratio=21:9
author=No.47 (16:9 base), 21:9 rescale
description=Renders the game in 21:9 (2.333) aspect ratio. Auto-enabled by "Apply Ultrawide (21:9) Patches" in the custom build (section name must be exactly "Widescreen 21:9"). Pair with the Ultrawide (21:9) display option, or leave Aspect Ratio on Auto 4:3/3:2 in stock PCSX2.
patch=1,EE,00383708,word,3F124925
patch=1,EE,00383728,word,3F124925


[Widescreen 64:27 (2.37, UW monitors)]
gsaspectratio=64:27
author=No.47 (16:9 base), l-kobra (2.37 value)
description=Renders the game in 2.370 aspect ratio for real 21:9 monitors (2560x1080 class). Use Stretch / Fit to Window in fullscreen.
patch=1,EE,00383708,word,3F100000
patch=1,EE,00383728,word,3F100000


[No-Interlacing]
description=Attempts to disable interlaced offset rendering.
gsinterlacemode=1
patch=1,EE,2013363C,word,34060001
patch=1,EE,20383A40,word,00009450


[Remove Speedometer Update Cap]
author=Azullia / real-xp
description=Allows the speedometer to update every frame instead of being capped at 3 UPS.
patch=3,EE,20117E74,extended,46000001 // sub.s f00, f01, f00 -> sub.s f00, f00, f00


[Fix Trigger Sensitivity]
author=real-xp / Azullia
description=Removes the deadzone and fixes the trigger range when using L2/R2 for brake/throttle.
patch=3,EE,201461E0,extended,240903DF // addiu t1, zero, 0xFF -> addiu t1, zero, 0x3DF
patch=3,EE,201461EC,extended,00842026 // lw a0, 0x2DC(s1) -> xor a0, a0, a0
patch=3,EE,201467C8,extended,46160003 // nop -> div.s f00, f00, f22
patch=3,EE,201467CC,extended,46000000 // div.s f00, f00, f22 -> add.s f00, f00, f00


[Remove Steering Deadzone]
author=Azullia / real-xp
description=Removes the deadzone from steering using the left analog stick.
patch=3,EE,2014615C,extended,00842026 // lw a0, 0x2D8(s1) -> xor a0, a0, a0


[Speedometer km/h]
author=Community (size nibble fixed: 00->20 for a 32-bit write)
description=Changes speedometer from MPH to KM/H (writes 3.6f m/s->km/h factor).
patch=1,EE,202A5B80,extended,40666666
